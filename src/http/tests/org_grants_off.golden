Counting alice tools/list	200	{"id":1,"jsonrpc":"2.0","result":{"_meta":{"io.yadgarhq/toolsPollIntervalSeconds":600},"cacheScope":"public","resultType":"complete","tools":[{"description":"Create a task in the caller's project. The id, number and version are assigned by the module.","inputSchema":{"properties":{"body":{"description":"Full description","type":"string"},"idempotency_key":{"description":"Makes a retry safe: the same key with the same arguments returns the first call's task; the same key with different arguments is refused. Scoped to the caller and project. Keys compare case-insensitively (`-`, `_`, `.` and `:` are significant). A replay returns the first call's version, which can be stale: re-read before editing. Omit it and the gateway uses a fresh key per call","maxLength":255,"minLength":1,"pattern":"^[!-~]+$","type":"string"},"legacy_ref":{"description":"A reference to this task in another tracker, URN-shaped, e.g. urn:yadgar:ledger:yadgarhq/docs:1558. Stored verbatim (not trimmed) as the task's only link and returned in `links`. A caller-supplied reference, not a parent link","maxLength":255,"minLength":1,"pattern":"\\S","type":"string"},"tags":{"items":{"type":"string"},"type":"array"},"title":{"description":"Short summary of the task, at most 128 characters (Unicode code points); put detail in the body","maxLength":128,"type":"string"}},"required":["title"],"type":"object"},"name":"create_task","title":"Create a task"},{"description":"Read one task by its id or by its per-project number.","inputSchema":{"properties":{"id":{"description":"URN, e.g. yadgar:task:0192...","type":"string"},"number":{"description":"Per-project task number","type":"integer"}},"type":"object"},"name":"read_task","title":"Read a task"},{"description":"List tasks visible to the caller, oldest first (by id, a UUIDv7 timestamp; task-db runs 2 replicas, so ids are ordered to the millisecond across replicas, not strictly by number). Filter by status with `statuses`; ask for `fields: \"summary\"` to leave out bodies, tags and links, or `fields: \"index\"` for number, status and title only. A listing reaches the caller's project and the projects below it, but edit_task and transition_task resolve a number in the caller's exact project only. So an index row from another project carries its `project_id`: to edit or move that task, use its id (from `fields: \"summary\"`), or work from that project.","inputSchema":{"properties":{"fields":{"default":"full","description":"summary: id, number, title, status and version only. index: number, status and title only, plus project_id on a row from a project other than the caller's","enum":["full","summary","index"],"type":"string"},"page_size":{"description":"Maximum results","type":"integer"},"page_token":{"description":"Continuation token","type":"string"},"statuses":{"description":"Only tasks in one of these statuses; omit for every status. A repeated status counts once","items":{"enum":["open","in_progress","blocked","done","dropped"],"type":"string"},"maxItems":5,"type":"array"}},"type":"object"},"name":"find_tasks","title":"Find tasks"},{"description":"Change a task's title, body, or both. Name the task by id or by number, not both. Only the fields sent are written; send at least one. Status is changed with transition_task, never here. Refused if the task's version is not expect_version, or if the body does not match expect_body_sha256. To change part of a body, send `patch` instead of `body`: a literal (not regex) replace of every occurrence of `old` by `new`, refused unless `old` occurs exactly expect_count times (counted non-overlapping, left to right). With a patch, expect_body_sha256 is the hash of the pre-edit body as read. `old` and `new` are at most 65536 bytes each.","inputSchema":{"properties":{"body":{"description":"New full description; empty clears it","type":"string"},"expect_body_sha256":{"description":"SHA-256 of the exact body bytes (sha256sum of the file you send); the edit is refused if the body that arrives does not match, so a cut-off body is never saved. With `patch`: SHA-256 of the pre-edit body as read","pattern":"^[0-9a-f]{64}$","type":"string"},"expect_version":{"description":"The version last read; the edit is refused if it moved","minimum":0,"type":"integer"},"id":{"description":"URN, e.g. yadgar:task:0192...","type":"string"},"number":{"description":"Per-project task number, instead of id","minimum":1,"type":"integer"},"patch":{"additionalProperties":false,"description":"Literal replace inside the stored body, instead of `body`","properties":{"expect_count":{"description":"How many times `old` occurs; refused otherwise","minimum":1,"type":"integer"},"new":{"description":"Replacement; empty deletes","type":"string"},"old":{"description":"Exact text to find; no regex, no normalisation","minLength":1,"type":"string"}},"required":["old","new","expect_count"],"type":"object"},"title":{"description":"Short summary of the task, at most 128 characters (Unicode code points); put detail in the body","maxLength":128,"type":"string"}},"required":["expect_version"],"type":"object"},"name":"edit_task","title":"Edit a task"},{"description":"Move a task to another status. Name the task by id or by number, not both. The module decides which moves are legal. Refused if the task's version is not expect_version.","inputSchema":{"properties":{"expect_version":{"description":"The version last read; the move is refused if it moved","minimum":0,"type":"integer"},"id":{"description":"URN, e.g. yadgar:task:0192...","type":"string"},"number":{"description":"Per-project task number, instead of id","minimum":1,"type":"integer"},"to":{"description":"The status to move to","enum":["open","in_progress","blocked","done","dropped"],"type":"string"}},"required":["expect_version","to"],"type":"object"},"name":"transition_task","title":"Transition a task"}],"ttlMs":300000}}
